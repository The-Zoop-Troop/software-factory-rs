# Copy to docker/rig.env (gitignored). Injected at container start; never baked into the image.
# One of these two for Claude Code (an API key, or the token from `claude setup-token`):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Project:
RIG_PREFIX=rig
RIG_REPO_URL=
RIG_MAIN=main
RIG_GIT_NAME=factory
RIG_GIT_EMAIL=factory@rig.local
# OpenCode worker (worker-opencode service): any OpenAI-compatible provider.
OPENCODE_PROVIDER_ID=
OPENCODE_PROVIDER_NAME=
OPENCODE_PROVIDER_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=
# Codex worker (worker-codex service, profile 'codex'):
OPENAI_API_KEY=
CODEX_MODEL=
