# Copy to docker/rig.env (gitignored). Injected at container start; never baked into the image.
# One of these two for Claude Code (an API key, or the token from `claude setup-token`):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# or: CLAUDE_AUTH_JSON=$(base64 -w0 ~/.claude/.credentials.json)   # full login incl. refresh token
CLAUDE_AUTH_JSON=
# Model and thinking effort (optional). Effort: low | medium | high | max.
CLAUDE_MODEL=
RIG_EFFORT=
# Per-role overrides: plan with a strong model, work with a cheaper one.
RIG_PLANNER_MODEL=
RIG_PLANNER_EFFORT=
RIG_WORKER_MODEL=
RIG_WORKER_EFFORT=
# Project:
RIG_PREFIX=rig
RIG_REPO_URL=
RIG_MAIN=main
# Branches the factory must never integrate into or push. A rig whose RIG_MAIN is listed here
# refuses to run its Integrator. Point RIG_MAIN at a feature branch to keep main untouched.
RIG_PROTECTED_BRANCHES=main,master
RIG_GIT_NAME=factory
RIG_GIT_EMAIL=factory@rig.local
# OpenCode worker (worker-opencode service): any OpenAI-compatible provider.
OPENCODE_PROVIDER_ID=
OPENCODE_PROVIDER_NAME=
OPENCODE_PROVIDER_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=
# Codex worker (worker-codex service, profile 'codex'): either an API key or a ChatGPT OAuth
# access token (from the `tokens.access_token` field of ~/.codex/auth.json on a logged-in host;
# it expires, the API key does not).
OPENAI_API_KEY=
# or: CODEX_AUTH_JSON=$(base64 -w0 ~/.codex/auth.json)   # full ChatGPT login incl. refresh token
# or: CODEX_OAUTH_TOKEN= (an agent-identity JWT; NOT the ChatGPT access token)
CODEX_AUTH_JSON=
CODEX_OAUTH_TOKEN=
CODEX_MODEL=
