# Egress proxy: the only path out of the rig network. Default-deny with a domain allowlist.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tinyproxy ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY egress/tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY egress/allowlist /etc/tinyproxy/allowlist
USER tinyproxy
EXPOSE 8888
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
