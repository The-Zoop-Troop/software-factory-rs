# --- build output
/target
/mutants.out*
*.profraw
*.profdata

# --- secrets (never commit; injected at container start)
docker/rig.env
docker/rig.env.*
!docker/rig.env.example
.env
.env.*

# --- Beads / Dolt local state (added by bd init; the tracked .beads files are bd's own)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/embeddeddolt/
.beads/last-touched
.beads/.local_version

# --- factory runtime state on the host (rigs keep theirs in volumes)
/.factory/
.factory-worktrees/
.factory-codex/

# --- per-developer harness/IDE config (the skills symlinks ARE tracked)
.idea/
.vscode/
.agents/
.claude/settings*.json
.codex/config.toml
.codex/hooks.json
.opencode/opencode.json

# --- OS / editor noise
.DS_Store
*.swp
*~
*.orig
*.log
/docker/egress/allowlist

# Console client tokens (hashed, but still per-deployment)
docker/console/tokens.toml
docker/console/rigs.toml
